# Environment variables
.env
.env.*
!.env.example

# Local dev data (compose.yml の EPISODES_DIR / BOOKS_DIR 既定)
data/*
!data/episodes
!data/books
data/episodes/*
!data/episodes/.gitkeep
data/books/*
!data/books/.gitkeep

# Environment-specific configs(初代の遺物。D-44 で config/ ごと削除したが、
# 開発機のローカルには development/staging/production.env が残っている。
# この行がそれらを無視する唯一のルールなので、公開事故を防ぐため残す)
config/environments/*.env

# Build outputs
/api
/worker
/bin
/ask
/search
/summarize
/crawl-once

# Test coverage and outputs
coverage*.out
coverage.html
test_output.txt
test-output.json
*.test
__debug_bin*

# Agent-generated documents (EDAF outputs)
.steering

# Screenshots (EDAF Phase 3)
docs/screenshots/

# CHANGELOG (auto-generated)
CHANGELOG.md

# Swagger generated files
docs/docs.go
docs/swagger.json
docs/swagger.yaml

# Claude Code
.claude/scripts/*
!.claude/scripts/.keep
.claude/sounds/*
!.claude/sounds/.keep

