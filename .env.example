# ============================================================
# pulse — 開発 Mac 用環境変数の雛形(ルート compose.yml が読む)
# ============================================================
# cp .env.example .env して値を記入する。
# 本番 Raspberry Pi は deploy/env.pi.example → deploy/.env を使う
# (キー構成は同じ。Pi のみ TAILNET_IP 等が追加で必要)。
# 秘密の値は .env にのみ記入し、チャット・コミット・PR に貼らないこと。
# ============================================================

# --- ホストパス ---
# 開発既定はリポジトリ内 ./data/*(gitignore 済み。compose.yml の既定値と同じ)
EPISODES_DIR=./data/episodes
BOOKS_DIR=./data/books

# --- PostgreSQL(必須) ---
POSTGRES_USER=catchup-feed
POSTGRES_DB=catchup-feed
# openssl rand -hex 24 などで生成して記入(URL に埋め込まれるため
# 記号を含む base64 より hex が安全)
POSTGRES_PASSWORD=
# ホスト側公開ポート(127.0.0.1 のみ)。旧 catchup-feed の 5432 と衝突しない値
POSTGRES_PORT=5433

# --- ダッシュボード認証(必須、U-3) ---
# openssl rand -base64 48 の出力
JWT_SECRET=
ADMIN_USER=admin
# make admin-hash で生成(パスワードを stdin から読み、bcrypt ハッシュを出力)。
# .env 内ではハッシュ中の '$' を '$$' にエスケープすること
ADMIN_PASSWORD_HASH=

# --- 公開経路(開発ではローカルのみ) ---
# server の公開リスナーを 127.0.0.1:${API_PORT} に公開(既定 8090)
API_PORT=8090
# 開発ダッシュボード(next dev)のオリジン
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 開発は localhost なので空(D-22 の親ドメイン共有は本番のみ)
AUTH_COOKIE_DOMAIN=

# --- フィード(§5 / D-6。既定値でよければ空のまま) ---
# FEED_PUBLIC_BASE_URL=https://radio.catchup-feed.com
# FEED_CHANNEL_TITLE=
# FEED_CHANNEL_DESCRIPTION=
# FEED_MAX_ITEMS=30
# FEED_PRIVATE_BASE_URL=
# 私的リスナーのコンテナ内バインド先(compose の既定 server:8081 のままでよい。
# 開発 Mac ではホストへ公開されない)
# PRIVATE_FEED_ADDR=server:8081

# --- 要約フォールバック連鎖(U-4 / U-5。開発では未設定でよい) ---
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_ENABLED=true
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# SUMMARIZER_CHAR_LIMIT=900
# SUMMARIZER_TIMEOUT=60s

# --- 通知(D-29。開発では無効のままでよい) ---
SMTP_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
NOTIFY_ERROR_EMAIL_TO=

# --- worker(既定値でよければ空のまま) ---
# CRON_SCHEDULE=0 * * * *
# CLEANUP_CRON_SCHEDULE=30 6 * * *
# JOBS_POLL_INTERVAL=10s
# CRAWL_TIMEOUT=30m
# WORKER_TIMEZONE=Asia/Tokyo
# NEWSLETTER_MAX_ARTICLES=10

# --- レートリミット(Cloudflare Tunnel 経由の本番のみ。開発では無効のまま) ---
# RATE_LIMIT_TRUST_PROXY=true
# RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1/32

# --- 任意 ---
# TZ=Asia/Tokyo
# LOG_LEVEL=info
