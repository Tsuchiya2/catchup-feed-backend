# pulse スタックのブート時起動を保証する oneshot ユニット(D-28: 復電後の自己復旧)。
#
# なぜ restart: unless-stopped だけでは足りないか:
#   compose.pi.yml は私的リスナーと PostgreSQL を Tailscale IP(TAILNET_IP)に
#   バインドする。ブート直後は tailscaled がまだ IP を持っておらずバインドに
#   失敗し得るが、Docker の再起動ポリシーは「一度も起動に成功していない
#   コンテナ」を再試行しない。このユニットが tailscaled 起動後に compose を
#   確実に立ち上げる。稼働中の自己回復(クラッシュ・OOM)は各コンテナの
#   restart: unless-stopped が担う。
#
# なぜ --force-recreate か(D-28、2026-07-22 停電障害の恒久対応):
#   ブレーカー断などの不正シャットダウンでは、コンテナが compose ネットワーク
#   から外れる等の壊れた状態がディスクに残り、docker の再起動ポリシーは
#   その壊れた状態のまま延々再起動するだけで復旧装置にならない(実証済み)。
#   毎起動でコンテナを作り直し、壊れた状態を構造的に捨てる。イメージと
#   ボリューム(DB データ・episodes)は再作成の影響を受けない。
#
# リトライ(D-28): 起動失敗時は systemd が失敗のたび 60 秒待機して再試行
#   (RestartSec=60 は失敗後の待機時間。次の試行自体の所要時間は別に加算)、
#   1 時間窓で計 5 回まで(StartLimit*)。無限ループにはしない。
#   ※ systemd 244 以降、Type=oneshot でも Restart=on-failure が使える
#   (Pi は systemd 255 で検証済み)。
#
# compose の呼び出し形(override 構成):
#   ルート compose.yml + deploy/compose.pi.yml の 2 枚重ね。project directory は
#   最初の -f のディレクトリ(= リポジトリルート)になるため、deploy/.env は
#   自動では読まれない。--env-file deploy/.env の明示が必須(pi.md 3章と同じ形)。
#
# 導入(pi.md 4章):
#   1. WorkingDirectory のパスを実際のリポジトリ位置に書き換える
#   2. sudo cp deploy/systemd/pulse.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload && sudo systemctl enable --now pulse.service

[Unit]
Description=pulse stack (server + worker + postgres via docker compose)
# docker.service は Requires ではなく Wants にする。Requires だと docker 側の
# 起動失敗が「依存失敗」となり、このユニットの Restart=on-failure の再試行対象に
# ならずスタックが落ちたままになるため。docker の readiness は ExecStartPre の
# `docker info` 待ちで保証し、間に合わなければ**自ユニットの失敗**として
# 60 秒待機 ×5 回のリトライの傘に入れる(D-28 停電復旧シナリオの穴埋め)。
After=docker.service network-online.target tailscaled.service
Wants=docker.service network-online.target tailscaled.service
# リトライの有限化: 1 時間の窓の中で 5 回失敗したらそれ以上試さない
# (窓 > 最悪所要時間 5 回 ×(TimeoutStartSec 300s + RestartSec 60s)= 30 分)
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
# リポジトリのルート(compose.yml がある場所)に書き換える。
# override の deploy/compose.pi.yml と deploy/.env は相対パスで参照する
WorkingDirectory=/home/CHANGEME/pulse/catchup-feed-backend
# After=tailscaled.service はプロセス起動順しか保証せず、tailnet IP の付与
# 完了は保証しない。IP が実際に付くまで待ってから compose を上げる
# (TimeoutStartSec=300 の範囲内。間に合わなければ失敗 → Restart= が再試行)。
# docker デーモンが応答するまで待つ(Wants 化に伴う readiness 保証)
ExecStartPre=/bin/sh -c 'until docker info >/dev/null 2>&1; do sleep 2; done'
ExecStartPre=/bin/sh -c 'until tailscale ip -4 >/dev/null 2>&1; do sleep 2; done'
ExecStart=/usr/bin/docker compose -f compose.yml -f deploy/compose.pi.yml --env-file deploy/.env up -d --force-recreate --remove-orphans
ExecStop=/usr/bin/docker compose -f compose.yml -f deploy/compose.pi.yml --env-file deploy/.env stop
Restart=on-failure
RestartSec=60
# 初回のイメージビルドは事前に手動で済ませる前提(pi.md 3章)
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
